{
 "note": "Recorded from the Node egress guard (lib/guard.mjs) before it was retired. {ECHO}, {PONG}, {PROXY}: ports of the servers in guard-servers.mjs.",
 "allow": [
  "api.anthropic.com",
  "127.0.0.1:{ECHO}",
  "127.0.0.1:{PONG}",
  "127.0.0.1:1",
  "*.example.org",
  "LocalHost:{ECHO}"
 ],
 "upstream": "http://us%40er:p%40ss@127.0.0.1:{PROXY}",
 "probes": [
  {
   "name": "unlisted host",
   "chained": false,
   "plain": false,
   "request": "CONNECT telemetry.example.com:443 HTTP/1.1\r\nHost: telemetry.example.com:443\r\n\r\n",
   "answer": "HTTP/1.1 403 Forbidden\r\nConnection: close\r\n\r\n"
  },
  {
   "name": "allowed host, wrong port",
   "chained": false,
   "plain": false,
   "request": "CONNECT api.anthropic.com:8443 HTTP/1.1\r\n\r\n",
   "answer": "HTTP/1.1 403 Forbidden\r\nConnection: close\r\n\r\n"
  },
  {
   "name": "host in mixed case: logged as sent",
   "chained": false,
   "plain": false,
   "request": "CONNECT Telemetry.Example.COM:443 HTTP/1.1\r\n\r\n",
   "answer": "HTTP/1.1 403 Forbidden\r\nConnection: close\r\n\r\n"
  },
  {
   "name": "allowed: tunnels through",
   "chained": false,
   "plain": false,
   "request": "CONNECT 127.0.0.1:{ECHO} HTTP/1.1\r\nHost: 127.0.0.1:{ECHO}\r\n\r\n",
   "answer": "HTTP/1.1 200 Connection Established\r\n\r\nhello-from-echo"
  },
  {
   "name": "bytes sent right after CONNECT reach the server",
   "chained": false,
   "plain": false,
   "request": "CONNECT 127.0.0.1:{PONG} HTTP/1.1\r\n\r\nPING",
   "answer": "HTTP/1.1 200 Connection Established\r\n\r\nPONG:PING"
  },
  {
   "name": "name allowed in another case, resolved locally",
   "chained": false,
   "plain": false,
   "request": "CONNECT localhost:{ECHO} HTTP/1.1\r\n\r\n",
   "answer": "HTTP/1.1 200 Connection Established\r\n\r\nhello-from-echo"
  },
  {
   "name": "*.example.org does not cover example.org",
   "chained": false,
   "plain": false,
   "request": "CONNECT example.org:443 HTTP/1.1\r\n\r\n",
   "answer": "HTTP/1.1 403 Forbidden\r\nConnection: close\r\n\r\n"
  },
  {
   "name": "port out of range",
   "chained": false,
   "plain": false,
   "request": "CONNECT x.com:99999 HTTP/1.1\r\n\r\n",
   "answer": "HTTP/1.1 403 Forbidden\r\nConnection: close\r\n\r\n"
  },
  {
   "name": "bad host characters: closed, not logged",
   "chained": false,
   "plain": false,
   "request": "CONNECT bad_host!:443 HTTP/1.1\r\n\r\n",
   "answer": ""
  },
  {
   "name": "no port: closed, not logged",
   "chained": false,
   "plain": false,
   "request": "CONNECT example.com HTTP/1.1\r\n\r\n",
   "answer": ""
  },
  {
   "name": "malformed request line",
   "chained": false,
   "plain": false,
   "request": "CONNECT a b:443 HTTP/1.1\r\n\r\n",
   "answer": "HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n"
  },
  {
   "name": "unknown method",
   "chained": false,
   "plain": false,
   "request": "BREW coffee HTTP/1.1\r\n\r\n",
   "answer": "HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n"
  },
  {
   "name": "lowercase method",
   "chained": false,
   "plain": false,
   "request": "connect x.com:443 HTTP/1.1\r\n\r\n",
   "answer": "HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n"
  },
  {
   "name": "HTTP/1.0",
   "chained": false,
   "plain": false,
   "request": "CONNECT x.com:443 HTTP/1.0\r\n\r\n",
   "answer": "HTTP/1.1 403 Forbidden\r\nConnection: close\r\n\r\n"
  },
  {
   "name": "HTTP/2.0",
   "chained": false,
   "plain": false,
   "request": "CONNECT x.com:443 HTTP/2.0\r\n\r\n",
   "answer": "HTTP/1.1 403 Forbidden\r\nConnection: close\r\n\r\n"
  },
  {
   "name": "headers over 16 KB",
   "chained": false,
   "plain": false,
   "request": "CONNECT x.com:443 HTTP/1.1\r\nX: \r\n\r\n",
   "answer": "HTTP/1.1 431 Request Header Fields Too Large\r\nConnection: close\r\n\r\n"
  },
  {
   "name": "over 16 KB of headers that never end",
   "chained": false,
   "plain": false,
   "request": "CONNECT x.com:443 HTTP/1.1\r\nX: ",
   "answer": "HTTP/1.1 431 Request Header Fields Too Large\r\nConnection: close\r\n\r\n"
  },
  {
   "name": "plain http is refused",
   "chained": false,
   "plain": true,
   "request": "GET http://Example.com/x HTTP/1.1\r\nHost: example.com\r\n\r\n",
   "answer": "HTTP/1.1 403 Forbidden | blocked by charness egress guard\n"
  },
  {
   "name": "plain http, no absolute URL",
   "chained": false,
   "plain": true,
   "request": "GET /x HTTP/1.1\r\nHost: a\r\n\r\n",
   "answer": "HTTP/1.1 403 Forbidden | blocked by charness egress guard\n"
  },
  {
   "name": "chained through the user's proxy, with its login",
   "chained": true,
   "plain": false,
   "request": "CONNECT 127.0.0.1:{ECHO} HTTP/1.1\r\n\r\n",
   "answer": "HTTP/1.1 200 Connection Established\r\n\r\nhello-from-echo"
  },
  {
   "name": "the user's proxy refuses: 502",
   "chained": true,
   "plain": false,
   "request": "CONNECT 127.0.0.1:1 HTTP/1.1\r\n\r\n",
   "answer": "HTTP/1.1 502 Bad Gateway\r\nConnection: close\r\n\r\n"
  }
 ],
 "log": "[{\"guard\":\"direct\",\"entry\":{\"host\":\"telemetry.example.com\",\"port\":443,\"allowed\":false}},{\"guard\":\"direct\",\"entry\":{\"host\":\"api.anthropic.com\",\"port\":8443,\"allowed\":false}},{\"guard\":\"direct\",\"entry\":{\"host\":\"Telemetry.Example.COM\",\"port\":443,\"allowed\":false}},{\"guard\":\"direct\",\"entry\":{\"host\":\"127.0.0.1\",\"port\":{ECHO},\"allowed\":true}},{\"guard\":\"direct\",\"entry\":{\"host\":\"127.0.0.1\",\"port\":{PONG},\"allowed\":true}},{\"guard\":\"direct\",\"entry\":{\"host\":\"localhost\",\"port\":{ECHO},\"allowed\":true}},{\"guard\":\"direct\",\"entry\":{\"host\":\"example.org\",\"port\":443,\"allowed\":false}},{\"guard\":\"direct\",\"entry\":{\"host\":\"x.com\",\"port\":99999,\"allowed\":false}},{\"guard\":\"direct\",\"entry\":{\"host\":\"x.com\",\"port\":443,\"allowed\":false}},{\"guard\":\"direct\",\"entry\":{\"host\":\"x.com\",\"port\":443,\"allowed\":false}},{\"guard\":\"direct\",\"entry\":{\"host\":\"example.com\",\"port\":80,\"allowed\":false,\"note\":\"plain http\"}},{\"guard\":\"direct\",\"entry\":{\"host\":\"?\",\"port\":80,\"allowed\":false,\"note\":\"plain http\"}},{\"guard\":\"chained\",\"entry\":{\"host\":\"127.0.0.1\",\"port\":{ECHO},\"allowed\":true}},{\"guard\":\"chained\",\"entry\":{\"host\":\"127.0.0.1\",\"port\":1,\"allowed\":true}}]",
 "proxyRequests": [
  "CONNECT 127.0.0.1:{ECHO} HTTP/1.1\r\nHost: 127.0.0.1:{ECHO}\r\nProxy-Authorization: Basic dXNAZXI6cEBzcw==\r\n\r\n",
  "CONNECT 127.0.0.1:1 HTTP/1.1\r\nHost: 127.0.0.1:1\r\nProxy-Authorization: Basic dXNAZXI6cEBzcw==\r\n\r\n"
 ]
}
